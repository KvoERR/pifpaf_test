# Скопируйте в .env и заполните (в git не коммитить!)
# На Railway эти же значения задаются в Settings -> Variables.

# Токен Apify (обязательно для реальных данных): console.apify.com -> Settings -> Integrations
APIFY_TOKEN=

# Актор-скрапер Instagram
APIFY_ACTOR_ID=apify/instagram-scraper

# Бюджет одного запроса в центах (для бесплатного плана 10-15)
APIFY_BUDGET=10

# Порт локального запуска (на Railway подставляется автоматически)
PORT=3000
